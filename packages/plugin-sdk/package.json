{
  "name": "@t3tools/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Types and build helpers for T3 Code plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./server/providers": {
      "types": "./src/providers.ts",
      "import": "./src/providers.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./src/web.ts"
    },
    "./atom": {
      "types": "./src/atom.ts",
      "import": "./src/atom.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./src/shared.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./src/ui.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts"
    }
  },
  "scripts": {
    "build:examples": "node scripts/build-examples.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/atom-react": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/source-control-core": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@types/node": "*",
    "@types/react": ">=19",
    "effect": "catalog:",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
