// Declarations for `scripts/build.ts`. A type imported from another workspace package needs that
// package's `src` listed here, so its declarations are written too and the build can bundle them.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": false,
    "checkJs": false,
    "rootDir": "../.."
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/testing/**"]
}
